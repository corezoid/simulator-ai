            },
            "holesClosed": {
              "type": "integer",
              "description": "Closed actor holes with eligible source and target references"
            },
            "nodes": {
              "type": "integer",
              "description": "Recipient-eligible actor placements on the layer"
            }
          }
        }
      },
      "x-audience": "public",
      "x-scope": "actors.readonly"
    }
  ]
