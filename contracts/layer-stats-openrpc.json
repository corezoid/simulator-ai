{
  "methods": [
    {
      "name": "graph/layer/stats/get",
      "params": [
        {
          "name": "accId",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Workspace identifier",
            "minLength": 1,
            "x-validation-rules": [
              "required",
              "min=1"
            ]
          }
        },
        {
          "name": "actorId",
          "required": true,
          "schema": {
            "type": "string",
            "description": "Layer actor identifier",
            "minLength": 1,
            "x-validation-rules": [
              "required",
              "min=1"
            ]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "properties": {
            "edgeHoles": {
